# ============================================================
# INDRA AI API — Environment Variables Reference
# Copy this file to .env and fill in the values.
# See Section 7.7 of the INDRA AI Enterprise Master Blueprint.
# ============================================================

# ------- App Config -----------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# JWT secret for local dev mock tokens.
# Replace with a 256-bit random secret in production.
JWT_SECRET=indra_ai_replace_with_strong_secret_in_prod

# AES-256 key for credential encryption (enterprise integrations)
ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ------- Firebase -------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------- Database (Prisma) ----------------------------------
# PostgreSQL database url (e.g. Supabase)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.pssnqkmiyakoejbpdpux.supabase.co:5432/postgres?schema=public"

# ------- OpenAI ---------------------------------------------
OPENAI_API_KEY=sk-replace-with-your-openai-key
OPENAI_ORG_ID=org-replace-with-your-org-id
EMBEDDING_MODEL=text-embedding-3-large
COMPLETION_MODEL=gpt-4o

# ------- Pinecone Vector DB ---------------------------------
PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=indra-ai-prod
PINECONE_ENVIRONMENT=us-east-1-aws

# ------- Redis (Upstash) ------------------------------------
REDIS_URL=rediss://replace-with-upstash-redis-url
REDIS_TOKEN=replace-with-upstash-token

# ------- Supabase Storage -----------------------------------
SUPABASE_URL=replace-with-supabase-url
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# ------- Stripe (Billing) -----------------------------------
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-secret

# ------- LangSmith (AI Observability) -----------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__replace-with-langsmith-key
LANGCHAIN_PROJECT=indra-ai-dev
